# ── Database ────────────────────────────────────────────────────────────
# Postgres with the pgvector extension enabled (CREATE EXTENSION vector;)
DATABASE_URL="postgresql://user:password@localhost:5432/replypilot"

# ── Auth ────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign/encrypt session material AND to
# HMAC-sign public-widget visitor tokens (src/lib/widget/visitor-token.ts).
# Required — the app throws on startup use of visitor tokens if unset,
# rather than silently signing with a weak/empty key.
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# ── AI provider ─────────────────────────────────────────────────────────
# AI_PROVIDER picks explicitly when it matters ("anthropic" | "gemini");
# otherwise whichever key below is set decides. If neither is set, the
# app runs on a deterministic dev fallback (see src/lib/ai/provider.ts)
# so the product is fully clickable without a key.
AI_PROVIDER=""
AI_PROVIDER_KEY=""
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Embeddings provider — required for real semantic search; dev fallback
# (a non-semantic hash-based stand-in) used when unset. Currently the
# Gemini provider handles both chat and embeddings itself when selected
# above; EMBEDDING_PROVIDER_KEY is unused unless you add a separate
# embeddings-only provider to src/lib/ai/provider.ts.
EMBEDDING_PROVIDER_KEY=""

# ── Object storage ──────────────────────────────────────────────────────
# Used for uploaded knowledge-base files (PDF/DOCX/TXT). Falls back to
# local disk storage under .storage/ when unset — dev only.
STORAGE_PROVIDER=""          # "r2" | ""  (S3/GCS not yet implemented — see storage.ts)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""
# R2-specific: from Cloudflare dashboard → R2 → Manage API tokens. NOT
# the same as the access key id — this is your Cloudflare account id,
# used to build the endpoint https://<id>.r2.cloudflarestorage.com
STORAGE_R2_ACCOUNT_ID=""

# ── Email (verification, password reset, invitations) ──────────────────
EMAIL_PROVIDER="resend"      # "resend" | "" (falls back to console logging when EMAIL_API_KEY is unset)
EMAIL_API_KEY=""
EMAIL_FROM="ReplyPilot <no-reply@replypilot.example>"

# ── Stripe billing ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""

# ── Rate limiting (production) ──────────────────────────────────────────
# Without these, rate limiting falls back to an in-memory adapter that
# only works correctly for a single process — fine for local dev, NOT
# safe across multiple production instances. See
# src/lib/security/rate-limit.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to "true" only if you run behind a proxy YOU control that
# sanitizes X-Forwarded-For before it reaches this app (most platforms'
# own headers — cf-connecting-ip, x-vercel-forwarded-for — are trusted
# automatically and don't need this). Leave unset/false otherwise, or
# rate limiting can be bypassed by spoofing this header.
TRUST_PROXY="false"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
